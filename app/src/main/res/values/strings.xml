    <!-- Accessibility Guide Dialog -->
    <string name="a11y_guide_title">Enable Accessibility Service</string>
    <string name="a11y_guide_step1">1. Open Android Accessibility settings below.</string>
    <string name="a11y_guide_step2">2. Tap “Downloaded apps” (or “Installed services”) and select ZeroUI.</string>
    <string name="a11y_guide_step3">3. Turn on “Use ZeroUI” and allow control.</string>
    <string name="a11y_guide_restricted">On Android 13+, if the switch is grayed out: open App Info for ZeroUI → tap ⋮ (top right) → “Allow restricted settings”.</string>
    <string name="a11y_guide_privacy">Privacy promise: ZeroUI never takes screenshots for AI, never reads password fields, and always stops before payments.</string>
